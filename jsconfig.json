{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "checkJs": true,
        "allowJs": true,
        "noEmit": true,
        "strict": false,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": [
            "vite/client"
        ],
        "maxNodeModuleJsDepth": 0
    },
    "include": [
        "src/**/*.js",
        "src/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "vendor"
    ]
}